# Copy to .env (in this folder) and fill in. Read by backend/run.py and backend/scripts/*.
# .env is git-ignored: never commit real passwords or keys.

# --- Admin login (UC-4.11) ---------------------------------------------------------------
# The password is hashed at startup and the plaintext is discarded. Leave empty to disable admin login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Alternatively give a Werkzeug hash instead of a password:
#   backend/.venv/bin/python -c "from werkzeug.security import generate_password_hash as h; print(h('your password'))"
# ADMIN_PASSWORD_HASH=
SESSION_IDLE_MINUTES=30

# --- data.gov.sg (UC-4.10) -------------------------------------------------------------
# Optional. Without a key data.gov.sg applies its lowest rate limit (the client waits and retries).
DATA_GOV_SG_API_KEY=
API_TIMEOUT_SECONDS=10
FETCH_LOOKBACK_MONTHS=3

# --- Daily update job ---------------------------------------------------------------------
SCHEDULER_ENABLED=true
DAILY_JOB_HOUR=3
TIMEZONE=Asia/Singapore

# --- Search, prediction and upload settings ----------------------------------------------
PAGE_SIZE=24
RECENT_MONTHS=12
FLOOR_AREA_TOLERANCE_SQM=5
TRAINING_WINDOW_MONTHS=24
# Minimum supporting sales for a prediction (TBD-07); fewer gives the insufficient-data message.
MIN_SAMPLES=30
MAX_UPLOAD_MB=50

# --- Paths (defaults are under backend/data/) ---------------------------------------------
# DB_PATH=
# MODEL_ARTEFACT_PATH=
# PORT=5001
